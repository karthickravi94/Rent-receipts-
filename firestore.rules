rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tenants collection - allow read/write (add auth rules if needed)
    match /tenants/{tenantId} {
      allow read, write: if true;
    }

    // Receipts collection
    match /receipts/{receiptId} {
      allow read, write: if true;
    }
  }
}
